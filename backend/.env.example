# ─────────────────────────────────────────
# WanderLog — Backend Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Server ──────────────────────────────
PORT=5000

# ── Database ────────────────────────────
# Local MongoDB (used when NODE_ENV=development)
MONGO_URI=mongodb://localhost:27017/wanderlog

# Production MongoDB Atlas (used when NODE_ENV=production)
# Get this from: mongodb.com/atlas → Connect → Drivers
MONGO_URI_PROD=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlog?retryWrites=true&w=majority&appName=Cluster0

# ── Authentication ───────────────────────
# Any long random string (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# ── Email (Nodemailer) ───────────────────
# For Gmail: enable 2FA then generate App Password at:
# myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# ── External APIs ────────────────────────
# OpenWeatherMap: openweathermap.org/api → free plan
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Unsplash: unsplash.com/developers → New Application → Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ── Environment ──────────────────────────
# Use 'development' locally, 'production' on Railway/Heroku
NODE_ENV=development

# ── CORS ─────────────────────────────────
# Local development
CLIENT_URL=http://localhost:3000
# Production (set to your Railway frontend URL)
# CLIENT_URL=https://your-frontend.up.railway.app
